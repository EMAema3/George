---
import Base from '../layouts/Base.astro';
import BookingWidget from '../components/BookingWidget.astro';
import { t, dateLocaleTag } from '../i18n/index.mjs';
import { flagship as p } from '../data/properties/index.mjs';

const { locale = 'en' } = Astro.props;
const tr = t(locale);
---
<Base locale={locale} pageKey="reviews">
  <section class="section" style="padding-bottom:24px">
    <div class="container">
      <h1>{tr('reviews.title')}</h1>
      <p style="max-width:62ch">{tr('reviews.intro')}</p>
      <p style="color:var(--ink-soft);font-size:0.95rem">{tr('reviews.langNote')}</p>
    </div>
  </section>
  <section class="container section" style="padding-top:0">
    <div class="review-grid">
      {p.reviews.map((r) => (
        <blockquote class="review" style="margin:0">
          <p lang={r.lang}>“{r.text}”</p>
          <footer>{r.name} · {new Date(r.month + '-15').toLocaleDateString(dateLocaleTag[locale] || 'en-US', { month: 'long', year: 'numeric' })} <span class="lang-tag">({r.lang.toUpperCase()})</span></footer>
        </blockquote>
      ))}
    </div>
  </section>
  <div class="tile-divider" role="presentation"></div>
  <section class="section"><div class="container" style="max-width:780px"><BookingWidget locale={locale} property={p} mode="hero" /></div></section>
</Base>
