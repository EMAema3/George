---
import Base from '../layouts/Base.astro';
import BookingWidget from '../components/BookingWidget.astro';
import { t, urlFor, dateLocaleTag } from '../i18n/index.mjs';
import { flagship as p } from '../data/properties/index.mjs';
import site from '../data/site.json';
import { vacationRentalSchema, lodgingBusinessSchema } from '../lib/schema.mjs';

const { locale = 'en' } = Astro.props;
const tr = t(locale);
const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? '';
const img = (f, s = '') => `${p.images.dir}/${f}${s ? `-${s}w` : ''}.webp`;
const hero = p.images.gallery[0];
const alt = (g) => g.alt[locale] ?? g.alt.en;
const nightly = p.pricing.baseNightly;
const demoNights = 5;
const here = nightly * demoNights + p.pricing.cleaningFee;
const platform = Math.round(here * 1.15);
const fmtMoney = (n) => '$' + n.toLocaleString(dateLocaleTag[locale] || 'en-US');
const routeCards = [
  { key: 'routeStay', img: p.images.gallery[4], href: urlFor('apartment', locale) },
  { key: 'routeWork', img: p.images.gallery[8], href: '/work-from-aruba/' },
  { key: 'routeCruise', img: p.images.gallery[7], href: '/before-your-cruise/' },
  { key: 'routeWeddings', img: p.images.gallery[13], href: '/weddings/' },
  { key: 'routeCarnival', img: p.images.gallery[2], href: '/carnival/' },
];
const mapsUrl = `https://www.google.com/maps/search/?api=1&query=${p.geo.lat},${p.geo.lng}`;
const schema = [vacationRentalSchema(p, siteUrl, locale), lodgingBusinessSchema(p, siteUrl, site)];
const icons = {
  pool: 'M2 17c2 0 2-1.4 4-1.4s2 1.4 4 1.4 2-1.4 4-1.4 2 1.4 4 1.4M2 21c2 0 2-1.4 4-1.4s2 1.4 4 1.4 2-1.4 4-1.4 2 1.4 4 1.4M14 4v9M8 4v9M8 7h6M8 11h6',
  gym: 'M4 9v6M7 7v10M17 7v10M20 9v6M7 12h10M2 12h2M20 12h2',
  garage: 'M3 21V8l9-5 9 5v13M7 21v-8h10v8M7 17h10',
  security: 'M12 3l8 3v5c0 5-3.5 8.5-8 10-4.5-1.5-8-5-8-10V6l8-3M9 12l2 2 4-4',
};
---
<Base locale={locale} pageKey="home" heroPreload={img(hero.file)} schema={schema}>
  <!-- HERO: the arcade photograph, full bleed, rate + date picker on top -->
  <section class="hero">
    <div class="hero-img">
      <img src={img(hero.file)} srcset={`${img(hero.file, 800)} 800w, ${img(hero.file)} 1535w`} sizes="100vw" alt={alt(hero)} fetchpriority="high" width="1535" height="1024" />
    </div>
    <div class="hero-scrim"></div>
    <div class="container hero-content">
      <p class="kicker">{tr('home.heroKicker')}</p>
      <h1>{tr('home.heroTitle')}</h1>
      <p class="hero-sub">{tr('home.heroSub')}</p>
      <p class="hero-rate">{tr('common.from')} <strong>${nightly}</strong> {tr('common.perNight')}</p>
      <BookingWidget locale={locale} property={p} mode="hero" />
    </div>
  </section>

  <!-- The honest beach statement — a conversion feature, not a confession -->
  <section class="section" style="padding-block:40px">
    <div class="container">
      <p style="max-width:70ch;font-size:1.1rem;border-left:5px solid var(--terracotta);padding-left:20px;margin:0">{tr('home.beachHonest')}</p>
    </div>
  </section>

  <div class="tile-divider" role="presentation"></div>

  <!-- Price comparison strip -->
  <section class="section">
    <div class="container">
      <h2>{tr('home.compareTitle')}</h2>
      <div class="compare-strip">
        <div class="compare-cell compare-here">
          <span>{tr('home.compareHere')} · {demoNights} {tr('common.nights')}</span>
          <span class="amount">{fmtMoney(here)}</span>
        </div>
        <div class="compare-cell compare-them">
          <span>{tr('home.comparePlatform')}</span>
          <span class="amount">{fmtMoney(platform)}</span>
        </div>
      </div>
      <p style="color:var(--ink-soft);margin-top:12px;font-size:0.95rem">{tr('home.compareNote')}</p>
    </div>
  </section>

  <!-- Proof tiles: resort-without-resort-fees, shown not claimed -->
  <section class="section" style="padding-top:0">
    <div class="container">
      <h2>{tr('home.proofTitle')}</h2>
      <div class="proof-grid">
        {[['pool', 'proofPool'], ['gym', 'proofGym'], ['garage', 'proofGarage'], ['security', 'proofSecurity']].map(([ic, key]) => (
          <div class="proof-tile">
            <svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={icons[ic]} /></svg>
            <p>{tr(`home.${key}`)}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <div class="tile-divider" role="presentation"></div>

  <!-- Gallery, eight frames -->
  <section class="section">
    <div class="container">
      <h2>{tr('home.galleryTitle')}</h2>
      <div class="gallery-grid">
        {p.images.gallery.slice(1, 9).map((g) => (
          <a href={img(g.file)} aria-label={alt(g)}>
            <img src={img(g.file, 800)} alt={alt(g)} loading="lazy" width="800" height="533" />
          </a>
        ))}
      </div>
      <p style="margin-top:16px"><a class="btn btn-outline" href={urlFor('apartment', locale)}>{tr('common.viewAllPhotos')}</a></p>
    </div>
  </section>

  <!-- The five routes -->
  <section class="section" style="padding-top:0">
    <div class="container">
      <h2>{tr('home.routesTitle')}</h2>
      <div class="routes-grid">
        {routeCards.map((c) => (
          <a class="card" href={c.href}>
            <div class="card-top"><img src={img(c.img.file, 480)} alt={alt(c.img)} loading="lazy" width="480" height="320" /></div>
            <div class="card-body">
              <h3 style="font-size:1.1rem">{tr(`home.${c.key}`)}</h3>
              <p class="card-promise">{tr(`home.${c.key}Promise`)}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <div class="tile-divider" role="presentation"></div>

  <!-- Three facts most visitors don't know -->
  <section class="section">
    <div class="container">
      <h2>{tr('home.factsTitle')}</h2>
      <div class="facts">
        {['fact1', 'fact2', 'fact3'].map((f) => <div class="fact">{tr(`home.${f}`)}</div>)}
      </div>
    </div>
  </section>

  <!-- Reviews, three, real names and months -->
  <section class="section" style="padding-top:0">
    <div class="container">
      <h2>{tr('home.reviewsTitle')}</h2>
      <div class="review-grid">
        {p.reviews.slice(0, 3).map((r) => (
          <blockquote class="review" style="margin:0">
            <p lang={r.lang}>“{r.text}”</p>
            <footer>{r.name} · {new Date(r.month + '-15').toLocaleDateString(dateLocaleTag[locale] || 'en-US', { month: 'long', year: 'numeric' })} {r.lang !== locale && <span class="lang-tag">({r.lang.toUpperCase()})</span>}</footer>
          </blockquote>
        ))}
      </div>
      <p style="margin-top:16px"><a href={urlFor('reviews', locale)}>{tr('reviews.title')} →</a></p>
    </div>
  </section>

  <div class="tile-divider" role="presentation"></div>

  <!-- Map + walk times -->
  <section class="section">
    <div class="container">
      <h2>{tr('home.mapTitle')}</h2>
      <p style="max-width:62ch">{tr('location.intro')}</p>
      <ul class="dist-list">
        {p.distances.map((d) => (
          <li>
            <span>{tr(`location.distances.${d.id}`)}</span>
            <span class="d-time">{d.walkMin ? `${d.walkMin} ${tr('location.walkMin')}` : `${d.driveMin} ${tr('location.driveMin')}`}</span>
          </li>
        ))}
      </ul>
      <p style="margin-top:16px"><a class="btn btn-outline" href={mapsUrl} rel="noopener">{tr('location.mapNote')}</a></p>
    </div>
  </section>

  <!-- Lead magnet: the itinerary in exchange for an email -->
  <section class="section" style="background:var(--tile-green);color:#fff">
    <div class="container" style="max-width:720px;text-align:center">
      <h2 style="color:#fff">{tr('home.leadTitle')}</h2>
      <p style="color:#dcebe2">{tr('home.leadSub')}</p>
      <form name="itinerary-lead" method="POST" data-netlify="true" netlify-honeypot="bot-field" style="display:flex;gap:10px;justify-content:center;flex-wrap:wrap;margin-top:18px">
        <input type="hidden" name="form-name" value="itinerary-lead" />
        <p style="display:none"><input name="bot-field" /></p>
        <input type="hidden" name="locale" value={locale} />
        <input type="email" name="email" required placeholder={tr('booking.emailPlaceholder')} style="flex:1;min-width:240px;max-width:360px;font:inherit;padding:14px 16px;border:none;border-radius:999px" aria-label="Email" />
        <button class="btn btn-terracotta" type="submit">{tr('home.leadBtn')}</button>
      </form>
    </div>
  </section>
</Base>
