---
import Base from '../layouts/Base.astro';
import BookingWidget from '../components/BookingWidget.astro';
import Gallery from '../components/Gallery.astro';
import { t, urlFor } from '../i18n/index.mjs';
import { flagship as p } from '../data/properties/index.mjs';
import { vacationRentalSchema } from '../lib/schema.mjs';

const { locale = 'en' } = Astro.props;
const tr = t(locale);
const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? '';
const specs = [
  { n: `${p.specs.sizeM2} m²`, l: tr('apartment.title') },
  { n: String(p.specs.maxGuests), l: tr('common.guests') },
  { n: p.specs.bedType, l: tr('apartment.sleepsTitle') },
  { n: `${p.specs.wifiMbps}+`, l: 'Mbps Wi-Fi' },
];
---
<Base locale={locale} pageKey="apartment" schema={[vacationRentalSchema(p, siteUrl, locale)]}>
  <section class="section" style="padding-bottom:24px">
    <div class="container">
      <p class="kicker">{p.name} · {p.address.city}</p>
      <h1>{tr('apartment.title')}</h1>
      <p class="lede">{tr('apartment.intro')}</p>
    </div>
  </section>

  <section class="container">
    <Gallery locale={locale} property={p} mode="full" uid="apt-gal" />
  </section>

  <section class="container" style="padding-top:32px">
    <div class="stats">{specs.map((s) => <div class="stat"><b>{s.n}</b><span>{s.l}</span></div>)}</div>
  </section>

  <section class="section">
    <div class="container" style="display:grid;grid-template-columns:1.2fr 1fr;gap:48px;align-items:start" id="apt-cols">
      <div>
        <h2>{tr('apartment.amenitiesTitle')}</h2>
        <ul class="amen-list">{p.amenities.map((a) => <li>{tr(`apartment.amenities.${a}`)}</li>)}</ul>
        <h2 style="margin-top:44px">{tr('apartment.sleepsTitle')}</h2>
        <p class="lede">{tr('apartment.sleepsText')}</p>
        <p style="font-size:1.05rem;border-left:5px solid var(--terracotta);padding-left:20px;margin-top:30px;color:var(--ink-soft)">{tr('home.beachHonest')}</p>
        <p style="margin-top:24px"><a href={urlFor('building', locale)}>{tr('nav.building')} →</a> · <a href={urlFor('location', locale)}>{tr('nav.location')} →</a> · <a href={urlFor('faq', locale)}>{tr('nav.faq')} →</a></p>
      </div>
      <div style="position:sticky;top:96px">
        <BookingWidget locale={locale} property={p} mode="hero" />
      </div>
    </div>
  </section>
  <style>@media (max-width: 900px) { #apt-cols { display: block !important; } #apt-cols > div:last-child { position: static !important; margin-top: 36px; } }</style>
</Base>
