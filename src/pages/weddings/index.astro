---
import Base from '../../layouts/Base.astro';
import BookingWidget from '../../components/BookingWidget.astro';
import { flagship as p } from '../../data/properties/index.mjs';
const img = (f, s = '') => `${p.images.dir}/${f}${s ? `-${s}w` : ''}.webp`;
const balcony = p.images.gallery.find((g) => g.file.includes('architecture-view'));
---
<Base locale="en" pageKey="weddings" enOnly={true}
  title="Wedding Guest Accommodation in Aruba — Walkable Oranjestad Stay | Casa Playa 204"
  description="The room your wedding guests stay in: a full apartment in Oranjestad's landmark building, walkable to dinner and the waterfront. Aruba is outside the hurricane belt — a date 12 months out is safe.">
  <section class="section" style="padding-bottom:24px">
    <div class="container">
      <p class="kicker">Weddings & guests · book 8–12 months ahead</p>
      <h1>Weddings & guests</h1>
      <p style="max-width:62ch;font-size:1.15rem">When the resort block fills up — or when your parents would rather have a kitchen, a washer and a quiet balcony than a 14th-floor room — this is the overflow your guests thank you for.</p>
    </div>
  </section>
  <section class="container" style="padding-bottom:40px">
    <div class="arch-img" style="aspect-ratio:16/8;max-height:420px">
      <img src={img(balcony.file, 800)} alt={balcony.alt.en} width="800" height="533" style="height:100%" />
    </div>
  </section>
  <section class="section" style="padding-top:0">
    <div class="container" style="max-width:760px">
      <h2>Why Aruba for a date set a year out</h2>
      <ul class="amen-list" style="grid-template-columns:1fr;max-width:680px">
        <li>Aruba sits outside the hurricane belt. For a wedding date booked 12 months ahead, this is close to decisive — most of the Caribbean cannot promise it.</li>
        <li>Same-sex marriage has been legal in Aruba since July 2024.</li>
        <li>Everything prices in US dollars, so the budget your guests see is the budget they pay.</li>
        <li>US preclearance at the airport means the trip home is as easy as a domestic flight.</li>
      </ul>
      <h2 style="margin-top:36px">For the couple planning it</h2>
      <p>Send us your date and guest list and we'll hold what we can, answer in whatever language your guests speak (the site runs in five), and add a celebration package — prosecco, flowers, charcuterie — to any arriving room. WhatsApp is the fastest way to reach us.</p>
    </div>
  </section>
  <div class="tile-divider" role="presentation"></div>
  <section class="section"><div class="container" style="max-width:780px"><BookingWidget locale="en" property={p} mode="hero" /></div></section>
</Base>
