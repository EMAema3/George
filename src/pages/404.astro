---
import Base from '../layouts/Base.astro';
---
<Base locale="en" pageKey="home" enOnly={true} title="Page not found — Casa Playa 204" description="That page doesn't exist. The apartment does.">
  <section class="tile-bg" style="min-height:70vh;display:flex;align-items:center;justify-content:center;padding:32px">
    <div style="background:var(--cream);border-radius:var(--arch);padding:56px 40px 40px;text-align:center;max-width:460px;box-shadow:var(--shadow-float)">
      <h1 style="font-size:2rem">That page wandered off to the beach.</h1>
      <p><a class="btn btn-primary" href="/">Back to the homepage</a></p>
    </div>
  </section>
</Base>
